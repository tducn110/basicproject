\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Bản đồ miền quyết định 2 chiều (2D Decision Region Map):} Phân tách không gian thành hai miền: \textit  {Miền Tấn Công} ($E_{\text  {atk}} > W_{\text  {threat}}$) và \textit  {Miền Phòng Thủ} ($W_{\text  {threat}} > E_{\text  {atk}}$). Ranh giới quyết định $\Delta E = 0$ phân định rõ ràng điểm lật nước đi tại $W = 90$, giải thích cơ chế chuyển trạng thái của bot khi vi chỉnh trọng số.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:area_decision}{{3}{11}{\textbf {Bản đồ miền quyết định 2 chiều (2D Decision Region Map):} Phân tách không gian thành hai miền: \textit {Miền Tấn Công} ($E_{\text {atk}} > W_{\text {threat}}$) và \textit {Miền Phòng Thủ} ($W_{\text {threat}} > E_{\text {atk}}$). Ranh giới quyết định $\Delta E = 0$ phân định rõ ràng điểm lật nước đi tại $W = 90$, giải thích cơ chế chuyển trạng thái của bot khi vi chỉnh trọng số}{figure.caption.8}{}}
