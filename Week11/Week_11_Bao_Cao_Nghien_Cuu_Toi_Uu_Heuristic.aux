\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Biểu đồ miền diện tích tối ưu hóa trọng số Heuristic dạng hình chuông (Bell Curve):} Phân chia không gian tìm kiếm thành 3 miền chiến thuật rõ rệt: (1) \textit  {Miền mù chiến thuật} ($W \le 3{,}500$, màu đỏ nhạt); (2) \textit  {Miền tối ưu Pareto} ($3{,}500 < W \le 25{,}000$, màu xanh lục) với đỉnh cực đại $75.0\%$ tại $W = 10{,}000$; (3) \textit  {Miền ám ảnh mẫu hình} ($W > 25{,}000$, màu vàng nhạt) nơi tỉ lệ thắng rơi tự do trở lại $50.0\%$.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:area_regimes}{{2}{10}{\textbf {Biểu đồ miền diện tích tối ưu hóa trọng số Heuristic dạng hình chuông (Bell Curve):} Phân chia không gian tìm kiếm thành 3 miền chiến thuật rõ rệt: (1) \textit {Miền mù chiến thuật} ($W \le 3{,}500$, màu đỏ nhạt); (2) \textit {Miền tối ưu Pareto} ($3{,}500 < W \le 25{,}000$, màu xanh lục) với đỉnh cực đại $75.0\%$ tại $W = 10{,}000$; (3) \textit {Miền ám ảnh mẫu hình} ($W > 25{,}000$, màu vàng nhạt) nơi tỉ lệ thắng rơi tự do trở lại $50.0\%$}{figure.caption.7}{}}
